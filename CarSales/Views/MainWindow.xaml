<Window x:Class="CarSales.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarSales.Views"
        mc:Ignorable="d"
        Title="Správa prodejů autosalonu" Height="720" Width="1280">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Načíst soubor (XML/CSV)" Padding="10,6" Margin="0,0,10,0" Background="#2196F3" Foreground="White" BorderThickness="0" Click="BtnClick_LoadSalesData"/>
                <Button Content="Uložit jako (XML/CSV) 💾" Padding="10,6" Background="#009688" Foreground="White" BorderThickness="0" Click="BtnClick_SaveSalesData"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="15,0,0,0">
                <TextBlock Text="Hledat:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <TextBox Width="200" Padding="5" VerticalAlignment="Center" Height="28"/>
            </StackPanel>

            <TextBlock Text="{Binding OpenedFilePath, StringFormat={}Otevřený soubor: {0}}" 
               VerticalAlignment="Center" 
               HorizontalAlignment="Left"
               Foreground="Gray" 
               FontStyle="Italic"
               Margin="10,0"
               TextTrimming="CharacterEllipsis"
               ToolTip="{Binding OpenedFilePath}"/>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,15">
            <Border Background="White" CornerRadius="5" Margin="0,0,10,0" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Prodaná vozidla" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="{Binding TotalVehiclesCount}" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="5" Margin="0,0,10,0" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Celkový obrat (s DPH)" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N0} Kč}" FontSize="22" FontWeight="Bold" Foreground="#4CAF50" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="5" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Průměrná cena bez DPH" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="{Binding AverageNetPrice, StringFormat={}{0:N0} Kč}" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0"
            x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">

            <TabItem Header="Všechna vozidla" Padding="15,6" FontWeight="SemiBold">
                <DataGrid ItemsSource="{Binding VehicleRowViewModels}" 
              AutoGenerateColumns="False" CanUserAddRows="False" 
              Background="White" RowHeight="25" BorderBrush="#E0E0E0" Margin="0,10,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Značka" Binding="{Binding ManufacturerName}" Width="*"/>
                        <DataGridTextColumn Header="Model" Binding="{Binding Vehicle.ModelName}" Width="*"/>
                        <DataGridTextColumn Header="Cena bez DPH" Binding="{Binding Vehicle.NetPrice, StringFormat={}{0:N0} Kč}" Width="*"/>
                        <DataGridTextColumn Header="DPH" Binding="{Binding Vehicle.VatPercent, StringFormat={}{0}%}" Width="60"/>
                        <DataGridTextColumn Header="Cena s DPH" Binding="{Binding Vehicle.GrossPrice, StringFormat={}{0:N0} Kč}" Width="*"/>
                        <DataGridTextColumn Header="Datum prodeje" Binding="{Binding Vehicle.SoldOn, StringFormat=\{0:dd.MM.yyyy\}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Víkendové prodeje 📅" Padding="15,6" FontWeight="SemiBold">
                <DataGrid ItemsSource="{Binding WeekendVehicleRowSummaryViewModels}" 
              AutoGenerateColumns="False" CanUserAddRows="False" 
              Background="White" RowHeight="25" BorderBrush="#E0E0E0" Margin="0,10,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Značka" Binding="{Binding VehicleManufacturerName}" Width="*"/>
                        <DataGridTextColumn Header="Model" Binding="{Binding VehicleModelName}" Width="*"/>

                        <DataGridTextColumn Header="Prodaných kusů o víkendu" Binding="{Binding TotalVehiclesSold}" Width="180" FontWeight="SemiBold"/>

                        <DataGridTextColumn Header="Celkem bez DPH" Binding="{Binding TotalNetPrice, StringFormat={}{0:N0} Kč}" Width="*"/>
                        <DataGridTextColumn Header="Celkem s DPH" Binding="{Binding TotalGrossPrice, StringFormat={}{0:N0} Kč}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>

        <Border Grid.Row="3" Background="#E9ECEF" CornerRadius="5" Margin="0,15,0,0" Padding="15">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=MainTabControl, Path=SelectedIndex}" Value="1">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Nové auto:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,5"/>

                    <TextBlock Text="Značka:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                    <TextBox x:Name="TxtNewManufacturer" Width="100" Margin="0,0,15,5" Padding="3"/>

                    <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                    <TextBox x:Name="TxtNewModel" Width="100" Margin="0,0,15,5" Padding="3"/>

                    <TextBlock Text="Cena bez DPH:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                    <TextBox x:Name="TxtNewNetPrice" Width="90" Margin="0,0,15,5" Padding="3" PreviewTextInput="TxtNumeric_PreviewTextInput" DataObject.Pasting="Txtnumeric_Pasting"/>

                    <TextBlock Text="DPH (%):" VerticalAlignment="Center" Margin="0,0,5,5"/>
                    <TextBox x:Name="TxtNewVatPercent" Width="50" Margin="0,0,15,5" Padding="3"  PreviewTextInput="TxtNumeric_PreviewTextInput" DataObject.Pasting="Txtnumeric_Pasting"/>

                    <TextBlock Text="Datum prodeje:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                    <DatePicker x:Name="DpNewSoldOn" Width="110" Margin="0,0,15,5" Padding="1"/>
                </WrapPanel>

                <Button Grid.Column="1" Content="Přidat do evidence" Padding="15,6" Background="#6C757D" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="BtnClick_AddVehicleRecord"/>
            </Grid>
        </Border>
    </Grid>
</Window>
